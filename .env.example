# The server intentionally does not load .env files. Export values from a secret
# manager or shell so an agent workspace cannot read the file.

AGENT_WEB_HOST=127.0.0.1
AGENT_WEB_PORT=8787
AGENT_WEB_AUTH_TOKEN=
# Set to 1 when the browser reaches the control plane over HTTPS.
AGENT_COOKIE_SECURE=0
# Required for MCP OAuth when the browser uses a non-loopback address. Use the
# public HTTPS origin, without a path. Localhost callbacks work automatically.
# AGENT_WEB_PUBLIC_URL=https://relay.example.com

# A worker is stopped this many milliseconds after its turn completes.
AGENT_IDLE_TIMEOUT_MS=300000
AGENT_DATA_DIR=./data
AGENT_WORKSPACE_SOURCE=
AGENT_ENABLE_MOCK=0

# Settings and credentials: encrypted records in a real PostgreSQL database.
AGENT_DATABASE_MODE=embedded
AGENT_DATABASE_PORT=55438
# AGENT_CONTROL_DIR=/private/control-plane/agent-code-web
# Managed PostgreSQL: set mode=postgres and both values from your secret manager.
# DATABASE_URL=postgresql://user:password@database:5432/agent_web
# AGENT_ENCRYPTION_KEY=<base64-encoded-random-32-byte-key>
AGENT_DATABASE_TLS=1
# Optional GitHub OAuth app with device flow enabled.
GITHUB_OAUTH_CLIENT_ID=

# gateway: real provider keys remain in the control-plane process.
# host: reuse the user's normal CLI login (convenient, not a strong secret boundary).
CODEX_AUTH_MODE=gateway
CLAUDE_AUTH_MODE=gateway
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_EFFORT=high
CLAUDE_BIN=claude
CLAUDE_MODEL=opus
CLAUDE_EFFORT=high

# Linux only. Creates a private PID/proc namespace for every agent process so it
# cannot inspect the control plane's /proc/<pid>/environ.
AGENT_PROCESS_ISOLATION=namespace

# local: one OS process per active chat.
# ec2: one stopped/resumed EC2 instance per chat (see deploy/aws/README.md).
AGENT_WORKER_BACKEND=local

# EC2 worker mode (all required except where noted)
AGENT_EC2_GATEWAY_ORIGIN=https://agents.example.com
AGENT_EC2_AMI_ID=
AGENT_EC2_INSTANCE_TYPE=t3.medium
AGENT_EC2_SUBNET_ID=
AGENT_EC2_SECURITY_GROUP_ID=
AGENT_EC2_KEY_NAME=
AGENT_EC2_SSH_PRIVATE_KEY=/absolute/path/to/id_ed25519
AGENT_EC2_SSH_USER=ubuntu
AGENT_EC2_USE_PUBLIC_IP=0
AGENT_EC2_VOLUME_GB=20
AWS_PROFILE=default
AWS_REGION=us-east-1
