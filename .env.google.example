# Optional manual alternative to Doppler; use npm run start:google:env.
# Copy to .env.google and restrict it to your OS user (chmod 600).
# Do not commit real secrets. Do not paste these credentials in a chat.
AGENT_GOOGLE_AUTH=1
AGENT_WEB_PUBLIC_URL=http://localhost:8787
# Register this exact Google OAuth web-client redirect URI:
# http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this verified Google email can initially claim legacy shared data.
AGENT_OWNER_EMAIL=
# Optional additional trusted users. No public self-registration.
AGENT_ALLOWED_EMAILS=
# AUTH_SECRET is optional: otherwise generated and saved in encrypted PostgreSQL.
# Keep the existing AGENT_CONTROL_DIR / AGENT_DATA_DIR if they were customized.
